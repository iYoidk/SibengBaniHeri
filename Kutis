-- Helper function to normalize element names
local function normalizeName(name)
    return string.lower(tostring(name):gsub("%s+", " "):gsub("^%s*(.-)%s*$", "%1"))
end

-- Main merge function
function module.MergeTwoFuseables(name1, name2)
    local n1 = normalizeName(name1)
    local n2 = normalizeName(name2)
    
    -- Check special recipes first (with chance)
    for _, recipe in ipairs(SPECIAL_RECIPES) do
        local ingredients = recipe[1]
        local ingredient1 = normalizeName(ingredients[1])
        local ingredient2 = normalizeName(ingredients[2])
        local result = recipe[2][1]
        local chance = recipe[3] or 100
        
        if (ingredient1 == n1 and ingredient2 == n2) or (ingredient1 == n2 and ingredient2 == n1) then
            if math.random(1, 100) <= chance then
                return result, true
            end
        end
    end
    
    -- Check normal recipes
    for _, recipe in ipairs(NORMAL_RECIPES) do
        local ingredients = recipe[1]
        local ingredient1 = normalizeName(ingredients[1])
        local ingredient2 = normalizeName(ingredients[2])
        local result = recipe[2][1]
        
        if (ingredient1 == n1 and ingredient2 == n2) or (ingredient1 == n2 and ingredient2 == n1) then
            return result, false
        end
    end
    
    return nil, false
end

-- Create visual element for merge result
function module.Make(element1, element2, recipeData, resultName, isSpecial)
    if not element1 or not element2 then return nil end
    
    local clone = element1:Clone()
    clone.Parent = element1.Parent
    
    -- Apply texture/color
    local textureGUI = getTextureGUI()
    if textureGUI and textureGUI.TextureGUI then
        textureGUI.TextureGUI(clone, recipeData)
    end
    
    -- Position at midpoint
    local x1 = element1.Position.X.Offset or 0
    local y1 = element1.Position.Y.Offset or 0
    local x2 = element2.Position.X.Offset or 0
    local y2 = element2.Position.Y.Offset or 0
    
    clone.Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2)
    
    -- Animate scale
    if clone:FindFirstChild("UIScale") then
        clone.UIScale.Scale = 0
        TweenService:Create(clone.UIScale, TweenInfo_Default, { Scale = 1 }):Play()
    end
    
    -- Clean up originals
    element1:Destroy()
    element2:Destroy()
    
    return clone
end

